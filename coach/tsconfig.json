{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "WebWorker", "WebWorker.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "types": []
  },
  "include": ["."]
}
