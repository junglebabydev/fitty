// Cloudflare Worker + static assets. Deployed by Workers Builds from github.com/junglebabydev/fitty
// (deploy command `npx wrangler deploy`; no preview-branch deploys). See docs/DEPLOY.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "fitty",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  // Every preview URL is one more public origin with the production secrets bound, outside any Access policy
  // that covers production only. Off unless previews are really needed.
  "preview_urls": false,
  // With a custom domain, also switch the workers.dev hostname off so the Access-protected domain is the only
  // origin. Not before: without a custom domain this takes the site offline.
  // "workers_dev": false,
  // The dashboard build command is empty, so Wrangler builds the app (tsc + vite → ./dist) before every deploy.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes (/train, /coach, ...) get index.html.
    "not_found_handling": "single-page-application",
    // Only the AI endpoint runs the Worker first; every other path is served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  // Off on purpose: this is a personal health app, so request logs are not collected by Cloudflare.
  "observability": { "enabled": false },
  // Brakes that do not live in isolate memory (worker/index.ts). AI_LIMITER: requests to /api/ai/* per client
  // address, counted per Cloudflare location. DailyBudget: AI calls per UTC day (DAILY_CALL_LIMIT in worker/guard.ts).
  "ratelimits": [{ "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "durable_objects": { "bindings": [{ "name": "DAILY_BUDGET", "class_name": "DailyBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyBudget"] }],
  // The coach Worker (wrangler.coach.jsonc). Deploy it first: /api/ai/coach/turn is forwarded to it.
  "services": [{ "binding": "COACH", "service": "fitty-coach" }],
  // Workers Paid only: more CPU time for large uploads. See docs/DEPLOY.md §8.
  // "limits": { "cpu_ms": 300 },
  // Plain settings only. Secrets (GEMINI_API_KEY or ANTHROPIC_API_KEY, COACH_BRIDGE_PIN) are added in the
  // dashboard or with `npx wrangler secret put`, never here.
  "vars": { "COACH_MODEL": "claude-opus-5" }
}
